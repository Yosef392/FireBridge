# Data mode: "demo" uses the built-in illustrative dataset (default).
# "api" fetches from the Python FastAPI backend at NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_DATA_MODE=demo
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Live hotspots on the Fire Map (server-side only, never sent to the browser).
# Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
